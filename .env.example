# Copy to .env and fill independent URL-safe credentials (hex is suitable).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=nilart
HTTP_PORT=8080
NILART_ENVIRONMENT=development
NILART_PUBLIC_ORIGIN=http://localhost:8080
# Required before configuring an SMS adapter; independent random secret, at least 32 bytes.
NILART_OTP_HMAC_KEY=
# Explicit development-only OTP inbox. Production rejects sandbox.
NILART_SMS_MODE=disabled
# Show the current fake OTP on the verification screen only in development.
NILART_DEV_MODE=false
# Enables the development-only sandbox SMS provider (alias for SMS_MODE=sandbox).
NILART_FAKE_SMS=false
# Production only: supplied existing PEM files, absolute paths.
PRODUCTION_BIND_IP=
TLS_CERT_PATH=
TLS_KEY_PATH=
MINIO_PRODUCTION_IMAGE=
