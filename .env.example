# Copy to .env and fill independent URL-safe credentials (hex is suitable).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=nilart
HTTP_PORT=8080
NILART_ENVIRONMENT=development
NILART_PUBLIC_ORIGIN=http://localhost:8080
# Required before configuring an SMS adapter; independent random secret, at least 32 bytes.
NILART_OTP_HMAC_KEY=
# Explicit development-only OTP inbox. Production rejects sandbox.
NILART_SMS_MODE=disabled
# Show the current fake OTP on the verification screen only in development.
NILART_DEV_MODE=false
# Enables the development-only sandbox SMS provider (alias for SMS_MODE=sandbox).
NILART_FAKE_SMS=false
# Production only: supplied existing PEM files, absolute paths.
PRODUCTION_BIND_IP=
TLS_CERT_PATH=
TLS_KEY_PATH=
MINIO_PRODUCTION_IMAGE=

# Development-only Zarinpal sandbox (never charges real money).
NILART_PAYMENT_MODE=disabled
# Official Zibal test merchant; no real money. Never put a live merchant in this mode.
NILART_ZIBAL_MERCHANT_ID=zibal
NILART_ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# Real Kavenegar SMS: enable only after templates are approved. No credentials in source.
NILART_KAVENEGAR_API_KEY=
NILART_KAVENEGAR_APPROVED_TEMPLATES=
NILART_KAVENEGAR_TEMPLATE_LOGIN=nilartlogin
NILART_KAVENEGAR_TEMPLATE_REGISTER=nilartregister
NILART_KAVENEGAR_TEMPLATE_RECOVERY=nilartrecovery
NILART_KAVENEGAR_TEMPLATE_PHONE_CHANGE=nilartphonechange

NILART_ORDER_SMS_ENABLED=false
NILART_KAVENEGAR_TEMPLATE_PURCHASE=nilartpurchase
NILART_KAVENEGAR_TEMPLATE_SHIPPED=nilartshipped

# Tapin remains disabled until the shop and API token are active.
NILART_TAPIN_ENABLED=false
NILART_TAPIN_TOKEN=
NILART_TAPIN_SHOP_ID=

# Basalam official personal access token; server-only. Never use browser session tokens.
NILART_BASALAM_ENABLED=false
NILART_BASALAM_TOKEN=
NILART_BASALAM_WEBHOOK_SECRET=
